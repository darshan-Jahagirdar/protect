# Copy to platform/.env for local runs outside Docker. platform/.env is gitignored.
PROTECT_ENV=dev
# PROTECT_DATABASE_URL=sqlite:////absolute/path/to/protect.sqlite   (default: platform/data/protect.sqlite)
PROTECT_BASE_URL=http://127.0.0.1:8000
# Required in prod (32+ random characters):
# PROTECT_SECRET_KEY=

# Alerts (our own team only, comma-separated). email_transport: console | smtp | graph (M2)
PROTECT_EMAIL_TRANSPORT=console
# PROTECT_SMTP_HOST=localhost
# PROTECT_SMTP_PORT=1025
# PROTECT_SMTP_STARTTLS=false
# PROTECT_SMTP_USERNAME=
# PROTECT_SMTP_PASSWORD=
PROTECT_ALERT_FROM=protect-alerts@localhost
PROTECT_ALERT_RECIPIENTS=
PROTECT_BACKUP_RECIPIENTS=
PROTECT_ACK_TIMEOUT_MINUTES=15
