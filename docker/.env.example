# Local demo settings. Copy to docker/.env and fill in random values:
#   cp docker/.env.example docker/.env
# docker/.env is gitignored. These are throwaway credentials for the localhost-only demo.

# PHP image for the demo site. 8.3.30 is vulnerable to PHP2Shell; 8.3.36 is the fix.
WP_PHP_IMAGE=php:8.3.30-apache

# WordPress version installed by wp-setup
WP_VERSION=7.1.3

WP_DB_PASSWORD=change-me
WP_DB_ROOT_PASSWORD=change-me
WP_ADMIN_USER=demo-admin
WP_ADMIN_PASSWORD=change-me
