   "cve": {
    "id": "CVE-2000-0967",
    "sourceIdentifier": "cve@mitre.org",
    "published": "2000-12-19T05:00:00.000",
    "lastModified": "2026-09-23T09:10:01.707",
    "vulnStatus": "Modified",
    "cveTags": [],
    "descriptions": [
     {
      "lang": "en",
      "value": "PHP 3 and 4 do not properly cleanse user-injected format strings, which allows remote attackers to execute arbitrary commands by triggering error messages that are improperly written to the error logs."
     },
     {
      "lang": "es",
      "value": "PHP 3 y 4 no sanean adecuadamente las cadenas de formato inyectadas por el usuario, lo que permite a atacantes remotos ejecutar comandos arbitrarios al desencadenar mensajes de error que se escriben incorrectamente en los registros de errores."
     }
    ],
